# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout:
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf

# Denote all files that are truly binary and should not be modified:
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.jar binary
*.aar binary
